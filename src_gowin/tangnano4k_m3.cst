// Tang Nano 4K (GW1NSR-LV4CQN48PC6/I5) Cortex-M3 SoC Pin Constraints
// Bank Voltages: Bank 0/1 = 3.3V (LVCMOS33), Bank 3 = 1.8V (LVCMOS18)
// Reserved/Avoided: JTAG (3,4,6,7,8), DONE (9), SPI Flash (1,2,47,48)

// System Clock (27 MHz Crystal, Bank 1, 3.3V)
IO_LOC "ext_clk" 45;
IO_PORT "ext_clk" IO_TYPE=LVCMOS33 PULL_MODE=UP;

// External Reset (Button S2, Bank 3, 1.8V)
IO_LOC "ext_rst_n" 15;
IO_PORT "ext_rst_n" IO_TYPE=LVCMOS18 PULL_MODE=UP;

// UART0 Mapped to 3.3V Bank 1 Header Pins (Connect 3.3V USB-UART adapter)
IO_LOC "uart_tx" 46;
IO_PORT "uart_tx" IO_TYPE=LVCMOS33 DRIVE=8;
IO_LOC "uart_rx" 44;
IO_PORT "uart_rx" IO_TYPE=LVCMOS33 PULL_MODE=UP;

// MAC output monitoring pins on Bank 3 (1.8V logic analyzer only)
IO_LOC "uo_out[0]" 13;
IO_PORT "uo_out[0]" IO_TYPE=LVCMOS18 PULL_MODE=NONE;
IO_LOC "uo_out[1]" 16;
IO_PORT "uo_out[1]" IO_TYPE=LVCMOS18 PULL_MODE=NONE;
IO_LOC "uo_out[2]" 17;
IO_PORT "uo_out[2]" IO_TYPE=LVCMOS18 PULL_MODE=NONE;
IO_LOC "uo_out[3]" 18;
IO_PORT "uo_out[3]" IO_TYPE=LVCMOS18 PULL_MODE=NONE;
IO_LOC "uo_out[4]" 19;
IO_PORT "uo_out[4]" IO_TYPE=LVCMOS18 PULL_MODE=NONE;
IO_LOC "uo_out[5]" 20;
IO_PORT "uo_out[5]" IO_TYPE=LVCMOS18 PULL_MODE=NONE;
IO_LOC "uo_out[6]" 21;
IO_PORT "uo_out[6]" IO_TYPE=LVCMOS18 PULL_MODE=NONE;
IO_LOC "uo_out[7]" 22;
IO_PORT "uo_out[7]" IO_TYPE=LVCMOS18 PULL_MODE=NONE;
